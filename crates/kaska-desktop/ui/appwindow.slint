import { Palette } from "std-widgets.slint";
import { AppTheme } from "styles/theme.slint";
export { AppTheme } from "styles/theme.slint";
import { TrafficItem, HeaderItem } from "components/traffic_types.slint";
import { Sidebar } from "components/sidebar.slint";
import { Header } from "components/header.slint";
import { StatusBar } from "components/status_bar.slint";
import { NetworkInspectorView } from "views/inspector.slint";
import { RepeaterView } from "views/repeater.slint";
import { ScopeView } from "views/scope.slint";
import { SettingsView } from "views/settings.slint";

export component AppWindow inherits Window {
    title: "Kaska — Native Security & Network Inspection Platform";
    min-width: 640px;
    min-height: 300px;
    max-width: 65535px;
    max-height: 65535px;
    preferred-width: 1180px;
    preferred-height: 680px;
    background: AppTheme.bg-base;
    // Geometry is sampled on resize to avoid intrinsic-layout feedback in Slint 1.18.1.
    private property <length> view-width: 1180px;
    private property <length> view-height: 680px;
    changed width => { root.view-width = root.width; }
    changed height => { root.view-height = root.height; }
    init => { Palette.color-scheme = ColorScheme.dark; root.view-width = root.width; root.view-height = root.height; }

    default-font-size: 14px;
    default-font-family: "sans-serif";
    in-out property <bool> request-body-tab;
    in-out property <bool> response-body-tab;
    in-out property <bool> show-response;
    in-out property <bool> show-details;
    in-out property <float> table-ratio: 0.4;

    // Navigation
    in-out property <int> active-tab: 0;

    // Proxy engine state
    in property <string> proxy-addr: "127.0.0.1:8080";
    in property <bool> proxy-running: true;
    in property <bool> is-sending-test: false;

    // Traffic data & counts
    in property <[TrafficItem]> transactions: [];
    in property <int> total-transactions-count: 0;
    in property <int> visible-transactions-count: 0;
    in-out property <int> selected-transaction-idx: -1;
    in property <string> active-req-headers: "";
    in property <[HeaderItem]> active-req-headers-list: [];
    in property <string> active-req-headers-omitted: "";
    in property <string> active-req-line: "";
    in property <string> active-req-body: "";
    in property <bool> active-req-is-binary: false;
    in property <bool> active-req-body-truncated: false;
    in property <string> active-resp-headers: "";
    in property <[HeaderItem]> active-resp-headers-list: [];
    in property <string> active-resp-headers-omitted: "";
    in property <string> active-resp-status-line: "";
    in property <string> active-resp-body: "";
    in property <bool> active-resp-is-binary: false;
    in property <bool> active-resp-body-truncated: false;
    in property <string> active-timing-text: "";
    in property <bool> secrets-revealed: false;

    // Status bar & environment
    in property <string> status-message: "Proxy listening on 127.0.0.1:8080";
    in property <string> os-info: "Windows x86_64";
    in property <int> transactions-count: 0;

    // Filter bar state
    in-out property <string> filter-search: "";
    in-out property <int> filter-method-idx: 0;
    in-out property <int> filter-status-idx: 0;
    in-out property <int> filter-outcome-idx: 0;
    in-out property <bool> filter-only-in-scope: false;
    in-out property <bool> filter-hide-connect: false;
    in-out property <bool> filter-hide-failed: false;

    // Repeater state & inputs
    in-out property <string> repeater-method: "GET";
    in-out property <string> repeater-url: "http://127.0.0.1:8989/api/status";
    in-out property <string> repeater-headers: "Host: 127.0.0.1:8989\nUser-Agent: Kaska-Repeater/0.1\nAccept: application/json";
    in-out property <string> repeater-body: "";
    in-out property <bool> repeater-is-running: false;
    in-out property <bool> repeater-is-cancelling: false;
    in-out property <string> repeater-status-text: "Idle";
    in-out property <int> repeater-status-code: 0;
    in-out property <int> repeater-duration-ms: 0;
    in-out property <string> repeater-response-headers: "";
    in-out property <string> repeater-response-body: "";
    in-out property <int> repeater-received-bytes: 0;
    in-out property <bool> repeater-body-is-binary: false;
    in-out property <bool> repeater-http-truncated: false;
    in-out property <bool> repeater-preview-truncated: false;
    in-out property <string> repeater-error-message: "";

    // Callbacks to Rust backend
    callback toggle-proxy();
    callback send-test-traffic();
    callback select-transaction(int);
    callback select-transaction-by-id(string);
    callback clear-history();
    callback filter-search-changed(string);
    callback filter-method-changed(int);
    callback filter-status-changed(int);
    callback filter-outcome-changed(int);
    callback filter-only-in-scope-changed(bool);
    callback filter-hide-connect-changed(bool);
    callback filter-hide-failed-changed(bool);
    callback reset-filters();
    callback toggle-reveal-secrets();
    callback send-repeater();
    callback cancel-repeater();
    callback reset-repeater-defaults();

    // Do not let the anchored shell impose its current size as a window minimum.
    Rectangle {
        min-width: 0px;
        min-height: 0px;
        max-width: 65535px;
        max-height: 65535px;
        // The shell is anchored to the window, not to child content minima.
        // Responsive child layouts must not feed back into the window width.
        sidebar := Sidebar {
            x: 0px;
            y: 0px;
            height: root.view-height;
            active-tab: root.active-tab;
            compact: root.view-width < 1050px;
            select-tab(idx) => { root.active-tab = idx; }
        }
        Rectangle {
            x: sidebar.width;
            y: 0px;
            width: root.view-width - sidebar.width;
            height: root.view-height;
            clip: true;
            // Main Column
            VerticalLayout {
                // Header
                Header {
                    title: root.active-tab == 0 ? "Network Inspector" :
                    root.active-tab == 1 ? "HTTP Repeater" :
                    root.active-tab == 2 ? "Target Scope" : "Settings & About";
                    subtitle: root.active-tab == 0 ? "Real-time HTTP traffic capture, header inspection and timing analysis" :
                    root.active-tab == 1 ? "Manual request composer and replay engine (Milestone 1 foundation)" :
                    root.active-tab == 2 ? "In-scope authorized target definitions and ethical boundary rules" :
                    "Local proxy listener ports, diagnostics, and Slint open-source credits";
                    proxy-addr: root.proxy-addr;
                    proxy-running: root.proxy-running;
                    is-sending-test: root.is-sending-test;
                    toggle-proxy => { root.toggle-proxy(); }
                    send-test-traffic => { root.send-test-traffic(); }
                }

                // View Content
                Rectangle {
                    background: AppTheme.bg-base;

                    if root.active-tab == 0: NetworkInspectorView {
                        proxy-running: root.proxy-running;
                        proxy-addr: root.proxy-addr;
                        request-body-tab <=> root.request-body-tab;
                        response-body-tab <=> root.response-body-tab;
                        show-response <=> root.show-response;
                        show-details <=> root.show-details;
                        table-ratio <=> root.table-ratio;
                        items: root.transactions;
                        total-count: root.total-transactions-count;
                        visible-count: root.visible-transactions-count;
                        selected-index <=> root.selected-transaction-idx;
                        active-req-headers: root.active-req-headers;
                        active-req-headers-list: root.active-req-headers-list;
                        active-req-headers-omitted: root.active-req-headers-omitted;
                        active-req-line: root.active-req-line;
                        active-req-body: root.active-req-body;
                        active-req-is-binary: root.active-req-is-binary;
                        active-req-body-truncated: root.active-req-body-truncated;
                        active-resp-headers: root.active-resp-headers;
                        active-resp-headers-list: root.active-resp-headers-list;
                        active-resp-headers-omitted: root.active-resp-headers-omitted;
                        active-resp-status-line: root.active-resp-status-line;
                        active-resp-body: root.active-resp-body;
                        active-resp-is-binary: root.active-resp-is-binary;
                        active-resp-body-truncated: root.active-resp-body-truncated;
                        active-timing-text: root.active-timing-text;
                        secrets-revealed: root.secrets-revealed;
                        toggle-reveal-secrets => { root.toggle-reveal-secrets(); }
                        filter-search <=> root.filter-search;
                        filter-method-idx <=> root.filter-method-idx;
                        filter-status-idx <=> root.filter-status-idx;
                        filter-outcome-idx <=> root.filter-outcome-idx;
                        filter-only-in-scope <=> root.filter-only-in-scope;
                        filter-hide-connect <=> root.filter-hide-connect;
                        filter-hide-failed <=> root.filter-hide-failed;
                        select-item(idx) => { root.select-transaction(idx); }
                        select-transaction-by-id(id) => { root.select-transaction-by-id(id); }
                        clear-history => { root.clear-history(); }
                        filter-search-changed(val) => { root.filter-search-changed(val); }
                        filter-method-changed(val) => { root.filter-method-changed(val); }
                        filter-status-changed(val) => { root.filter-status-changed(val); }
                        filter-outcome-changed(val) => { root.filter-outcome-changed(val); }
                        filter-only-in-scope-changed(val) => { root.filter-only-in-scope-changed(val); }
                        filter-hide-connect-changed(val) => { root.filter-hide-connect-changed(val); }
                        filter-hide-failed-changed(val) => { root.filter-hide-failed-changed(val); }
                        reset-filters => { root.reset-filters(); }
                    }

                    if root.active-tab == 1: RepeaterView {
                        method <=> root.repeater-method;
                        url <=> root.repeater-url;
                        headers <=> root.repeater-headers;
                        body <=> root.repeater-body;
                        is-running: root.repeater-is-running;
                        is-cancelling: root.repeater-is-cancelling;
                        status-text: root.repeater-status-text;
                        status-code: root.repeater-status-code;
                        duration-ms: root.repeater-duration-ms;
                        response-headers: root.repeater-response-headers;
                        response-body: root.repeater-response-body;
                        received-bytes: root.repeater-received-bytes;
                        body-is-binary: root.repeater-body-is-binary;
                        http-truncated: root.repeater-http-truncated;
                        preview-truncated: root.repeater-preview-truncated;
                        error-message: root.repeater-error-message;
                        send-request => { root.send-repeater(); }
                        cancel-request => { root.cancel-repeater(); }
                        reset-defaults => { root.reset-repeater-defaults(); }
                    }

                    if root.active-tab == 2: ScopeView {}

                    if root.active-tab == 3: SettingsView {
                        proxy-port: "8080";
                        test-port: "8989";
                        os-info: root.os-info;
                    }
                }

                // Bottom Status Bar
                StatusBar {
                    status-text: root.status-message;
                    os-info: root.os-info;
                    transactions-count: root.transactions-count;
                }
            }
        }
    }
}
