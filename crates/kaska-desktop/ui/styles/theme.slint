export global AppTheme {
    out property <color> bg-base: #181818;
    out property <color> bg-surface: #202020;
    out property <color> bg-card: #202020;
    out property <color> bg-input: #181818;
    out property <color> bg-row-hover: #262626;
    out property <color> bg-row-selected: #363636;
    out property <color> control-pressed: #454545;
    out property <color> border-subtle: #363636;
    out property <color> border-control: #808080;
    out property <color> border-focus: #e0e0e0;
    out property <color> text-primary: #f2f2f2;
    out property <color> text-secondary: #c6c6c6;
    out property <color> text-muted: #a0a0a0;
    out property <color> text-disabled: #808080;
    out property <color> accent: #363636;
    out property <color> accent-hover: #454545;
    out property <color> accent-soft: #262626;
    // Status is always labeled. The approved palette has no chromatic accent.
    out property <color> success: #c6c6c6;
    out property <color> success-soft: #262626;
    out property <color> warning: #f2f2f2;
    out property <color> warning-soft: #262626;
    out property <color> danger: #f2f2f2;
    out property <color> danger-soft: #262626;
    out property <color> info: #c6c6c6;
    out property <color> info-soft: #262626;
    out property <color> method-get: #c6c6c6;
    out property <color> method-post: #c6c6c6;
    out property <color> method-put: #c6c6c6;
    out property <color> method-delete: #c6c6c6;
    in property <string> mono-font: "monospace";
}
