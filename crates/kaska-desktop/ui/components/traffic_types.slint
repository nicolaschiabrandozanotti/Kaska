export struct TrafficItem {
    id: string,
    method: string,
    host: string,
    path: string,
    status-code: int,
    status-text: string,
    duration-ms: int,
    size-bytes: int,
    content-type: string,
    is-error: bool,
}

export struct HeaderItem {
    name: string,
    value: string,
    is-sensitive: bool,
    is-truncated: bool,
}
