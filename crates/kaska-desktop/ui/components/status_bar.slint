import { AppTheme } from "../styles/theme.slint";

export component StatusBar inherits Rectangle {
    min-width: 0px;
    in property <string> status-text: "Ready";
    in property <string> os-info;
    in property <int> transactions-count;
    in property <string> license-info: "Built with Slint | Open Source / Royalty-Free Compatible";
    accessible-role: content-info;
    accessible-label: "Application status";
    height: 28px;
    background: AppTheme.bg-surface;
    border-color: AppTheme.border-subtle;
    border-width: 1px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 16px;
        Text { text: root.status-text; color: AppTheme.text-secondary; font-size: 12px; overflow: elide; vertical-alignment: center; Tooltip { text: @markdown("\{root.status-text}"); } }
        Text { text: root.transactions-count + " requests"; color: AppTheme.text-muted; font-size: 12px; vertical-alignment: center; }
        if root.width > 800px: Text { text: root.os-info; color: AppTheme.text-muted; font-size: 12px; vertical-alignment: center; }
        if root.width > 1250px: Text { text: root.license-info; color: AppTheme.text-muted; font-size: 12px; vertical-alignment: center; }
    }
}
