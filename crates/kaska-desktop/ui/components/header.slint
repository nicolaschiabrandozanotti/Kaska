import { AppTheme } from "../styles/theme.slint";
import { ActionButton } from "action_button.slint";

export component Header inherits Rectangle {
    min-width: 0px;
    in property <string> title;
    in property <string> subtitle;
    in property <string> proxy-addr;
    in property <bool> proxy-running;
    in property <bool> is-sending-test;
    accessible-role: banner;
    accessible-label: root.title;
    callback toggle-proxy();
    callback send-test-traffic();
    background: AppTheme.bg-surface;
    border-color: AppTheme.border-subtle;
    border-width: 1px;
    height: root.width < 600px ? 80px : root.width < 900px ? 100px : 68px;
    VerticalLayout {
        padding: root.width < 600px ? 8px : 12px;
        spacing: 6px;
        HorizontalLayout {
            Text { text: root.title; font-size: 20px; font-weight: 600; color: AppTheme.text-primary; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.width >= 900px: HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 8px;
                ActionButton { text: root.is-sending-test ? "Sending..." : "Test local capture"; icon: @image-url("../assets/icons/flask-conical.svg"); enabled: root.proxy-running && !root.is-sending-test; description: "Send controlled requests to the local test server"; clicked => { root.send-test-traffic(); } }
                ActionButton { text: root.proxy-running ? "Stop capture" : "Start capture"; icon: root.proxy-running ? @image-url("../assets/icons/square.svg") : @image-url("../assets/icons/play.svg"); clicked => { root.toggle-proxy(); } }
            }
        }
        if root.width >= 600px: HorizontalLayout {
            spacing: 8px;
            Text { text: (root.proxy-running ? "Listening" : "Stopped") + " | " + root.proxy-addr; color: AppTheme.text-secondary; font-size: 12px; vertical-alignment: center; }
            if root.width < 900px && root.width >= 600px: HorizontalLayout {
                spacing: 8px;
                ActionButton { text: root.is-sending-test ? "Sending..." : "Test capture"; icon: @image-url("../assets/icons/flask-conical.svg"); enabled: root.proxy-running && !root.is-sending-test; description: "Send controlled local test traffic"; clicked => { root.send-test-traffic(); } }
                ActionButton { text: root.proxy-running ? "Stop" : "Start"; icon: root.proxy-running ? @image-url("../assets/icons/square.svg") : @image-url("../assets/icons/play.svg"); description: root.proxy-running ? "Stop capture" : "Start capture"; clicked => { root.toggle-proxy(); } }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.width < 600px: HorizontalLayout {
            spacing: 8px;
            ActionButton { text: root.is-sending-test ? "Sending..." : "Test capture"; icon: @image-url("../assets/icons/flask-conical.svg"); enabled: root.proxy-running && !root.is-sending-test; clicked => { root.send-test-traffic(); } }
            ActionButton { text: root.proxy-running ? "Stop capture" : "Start capture"; icon: root.proxy-running ? @image-url("../assets/icons/square.svg") : @image-url("../assets/icons/play.svg"); clicked => { root.toggle-proxy(); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
