import { AppTheme } from "../styles/theme.slint";

export component Header inherits Rectangle {
    in property <string> title: "Network Inspector";
    in property <string> subtitle: "Live HTTP traffic interception and analysis";
    in property <string> proxy-addr: "127.0.0.1:8080";
    in property <bool> proxy-running: true;
    in property <bool> is-sending-test: false;
    callback toggle-proxy();
    callback send-test-traffic();

    height: 64px;
    background: AppTheme.bg-surface;
    border-color: AppTheme.border-subtle;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 16px;
        alignment: space-between;

        // Title and subtitle
        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: AppTheme.text-primary;
                font-size: 18px;
                font-weight: 700;
            }

            Text {
                text: root.subtitle;
                color: AppTheme.text-muted;
                font-size: 12px;
            }
        }

        // Actions and Status
        HorizontalLayout {
            alignment: center;
            spacing: 12px;

            // Proxy Status Badge
            Rectangle {
                background: root.proxy-running ? #064e3b : #2d1810;
                border-color: root.proxy-running ? AppTheme.success : AppTheme.warning;
                border-width: 1px;
                border-radius: 6px;
                height: 34px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.proxy-running ? AppTheme.success : AppTheme.warning;
                    }

                    Text {
                        text: root.proxy-running ? ("Proxy: " + root.proxy-addr + " (Active)") : "Proxy Paused";
                        color: root.proxy-running ? #a7f3d0 : #fde68a;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            // Test HTTP traffic button
            test-btn := Rectangle {
                height: 34px;
                background: root.is-sending-test ? #1e293b : test-touch.has-hover ? #374151 : #1f2937;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 6px;
                animate background { duration: 150ms; }

                test-touch := TouchArea {
                    enabled: !root.is-sending-test && root.proxy-running;
                    clicked => { root.send-test-traffic(); }
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: "⚡";
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.is-sending-test ? "Sending..." : "Test Local Capture";
                        color: AppTheme.text-primary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }

            // Toggle Proxy Button
            toggle-btn := Rectangle {
                height: 34px;
                background: root.proxy-running ? (toggle-touch.has-hover ? #dc2626 : #ef4444) : (toggle-touch.has-hover ? AppTheme.accent-hover : AppTheme.accent);
                border-radius: 6px;
                animate background { duration: 150ms; }

                toggle-touch := TouchArea {
                    clicked => { root.toggle-proxy(); }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: root.proxy-running ? "⏹ Stop Capture" : "▶ Start Capture";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
