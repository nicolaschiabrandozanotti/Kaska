import { ScrollView } from "std-widgets.slint";
import { AppTheme } from "../styles/theme.slint";

export component PageScrollView inherits Rectangle {
    in property <string> label;
    min-width: 0px;
    min-height: 0px;
    forward-focus: keys;
    accessible-role: region;
    accessible-label: root.label;
    accessible-description: "Use arrow keys, PageUp/PageDown, Home or End to scroll";
    border-width: keys.has-focus ? 2px : 0px;
    border-color: AppTheme.border-focus;
    function scroll-by(delta: length) {
        scroll.content-y = max(-max(0px, scroll.content-height - scroll.visible-height), min(0px, scroll.content-y + delta));
    }
    keys := FocusScope {
        x: 2px; y: 2px;
        width: parent.width - 4px; height: parent.height - 4px;
        key-pressed(event) => {
            if event.text == Key.DownArrow { root.scroll-by(-32px); return accept; }
            if event.text == Key.UpArrow { root.scroll-by(32px); return accept; }
            if event.text == Key.PageDown { root.scroll-by(-max(32px, scroll.visible-height - 32px)); return accept; }
            if event.text == Key.PageUp { root.scroll-by(max(32px, scroll.visible-height - 32px)); return accept; }
            if event.text == Key.Home { scroll.content-y = 0px; return accept; }
            if event.text == Key.End { scroll.content-y = -max(0px, scroll.content-height - scroll.visible-height); return accept; }
            return reject;
        }
        scroll := ScrollView {
            horizontal-scrollbar-policy: always-off;
            @children
        }
    }
}
