import { AppTheme } from "../styles/theme.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> short-label;
    in property <image> icon;
    in property <bool> compact;
    in property <bool> is-active;
    callback clicked();
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.is-active ? "Current tool" : "Open " + root.label;
    accessible-item-selected: root.is-active;
    accessible-action-default => { root.clicked(); }
    min-height: 44px;
    preferred-height: 44px;
    background: touch.pressed ? AppTheme.control-pressed : root.is-active ? AppTheme.bg-row-selected : touch.has-hover ? AppTheme.bg-row-hover : transparent;
    border-radius: 4px;
    border-width: keys.has-focus ? 2px : 0px;
    border-color: AppTheme.border-focus;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { clicked => { keys.focus(); root.clicked(); } }
    if root.is-active: Rectangle { x: 0px; y: 10px; width: 2px; height: parent.height - 20px; background: AppTheme.text-primary; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        Rectangle {
            width: 18px;
            background: transparent;
            Image { y: (parent.height - self.height) / 2; source: root.icon; width: 18px; height: 18px; colorize: AppTheme.text-secondary; accessible-role: none; }
        }
        Text { text: root.compact ? root.short-label : root.label; font-size: 13px; color: AppTheme.text-primary; vertical-alignment: center; }
    }
    if root.compact: Tooltip { text: @markdown("\{root.label}"); }
}

export component Sidebar inherits Rectangle {
    min-height: 0px;
    in-out property <int> active-tab;
    in property <bool> compact;
    callback select-tab(int);
    width: root.compact ? 120px : 192px;
    background: AppTheme.bg-surface;
    border-color: AppTheme.border-subtle;
    border-width: 1px;
    accessible-role: navigation;
    accessible-label: "Tools";
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        Rectangle {
            height: 48px;
            Text { x: 10px; text: "KASKA"; color: AppTheme.text-primary; font-size: root.compact ? 18px : 23px; font-weight: 700; vertical-alignment: center; }
        }
        NavItem { label: "Network Inspector"; short-label: "Inspector"; icon: @image-url("../assets/icons/network.svg"); compact: root.compact; is-active: root.active-tab == 0; clicked => { root.select-tab(0); } }
        NavItem { label: "HTTP Repeater"; short-label: "Repeater"; icon: @image-url("../assets/icons/repeat-2.svg"); compact: root.compact; is-active: root.active-tab == 1; clicked => { root.select-tab(1); } }
        NavItem { label: "Target Scope"; short-label: "Scope"; icon: @image-url("../assets/icons/shield-check.svg"); compact: root.compact; is-active: root.active-tab == 2; clicked => { root.select-tab(2); } }
        NavItem { label: "Settings & About"; short-label: "Settings"; icon: @image-url("../assets/icons/settings.svg"); compact: root.compact; is-active: root.active-tab == 3; clicked => { root.select-tab(3); } }
        Rectangle { vertical-stretch: 1; }
        if root.height > 420px: Text { text: "Kaska v0.1.0"; color: AppTheme.text-muted; font-size: 12px; }
        if root.height > 420px: Text { text: "Built with Slint"; color: AppTheme.text-muted; font-size: 12px; }
        if root.height > 420px: Text { text: "Authorized audits only"; color: AppTheme.text-muted; font-size: 12px; wrap: word-wrap; }
    }
}
