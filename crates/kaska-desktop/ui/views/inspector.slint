import { ListView, ScrollView, ComboBox } from "std-widgets.slint";
import { AppTheme } from "../styles/theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { DocumentPanel, DocumentView } from "../components/document_view.slint";
import { TrafficItem } from "../components/traffic_types.slint";

component TrafficColumns inherits HorizontalLayout {
    in property <TrafficItem> item;
    in property <bool> heading: false;
    padding-left: 10px;
    padding-right: 10px;
    spacing: 8px;
    Text { text: root.heading ? "ID" : root.item.id; width: 44px; color: AppTheme.text-muted; font-size: 12px; vertical-alignment: center; }
    Text { text: root.heading ? "Method" : root.item.method; width: 72px; color: root.heading ? AppTheme.text-muted : AppTheme.text-primary; font-size: 13px; vertical-alignment: center; }
    Text { text: root.heading ? "Status" : root.item.status-code > 0 ? root.item.status-code : root.item.status-text; width: 64px; color: AppTheme.text-secondary; font-size: 13px; vertical-alignment: center; Tooltip { text: @markdown("\{root.item.status-text}"); } }
    Text { text: root.heading ? "Host" : root.item.host; width: 170px; color: AppTheme.text-secondary; font-size: 13px; overflow: elide; vertical-alignment: center; Tooltip { text: @markdown("\{root.item.host}"); } }
    Text { text: root.heading ? "Path" : root.item.path; min-width: 180px; horizontal-stretch: 1; color: AppTheme.text-primary; font-size: 13px; overflow: elide; vertical-alignment: center; Tooltip { text: @markdown("\{root.item.path}"); } }
    Text { text: root.heading ? "Time" : root.item.duration-ms + " ms"; width: 80px; color: AppTheme.text-secondary; font-size: 13px; vertical-alignment: center; }
    Text { text: root.heading ? "Size" : root.item.size-bytes + " B"; width: 80px; color: AppTheme.text-secondary; font-size: 13px; vertical-alignment: center; }
    Text { text: root.heading ? "Type" : root.item.content-type; width: 160px; color: AppTheme.text-secondary; font-size: 13px; overflow: elide; vertical-alignment: center; Tooltip { text: @markdown("\{root.item.content-type}"); } }
}


component FilterToggleCheckbox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    in property <string> description: "";
    callback toggled(bool);
    private property <bool> keyboard-pressed;
    forward-focus: keys;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-description: root.description;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(root.checked); }
    min-height: 24px;
    preferred-height: 24px;
    max-height: 24px;
    min-width: content.min-width + 6px;
    horizontal-stretch: 0;
    background: transparent;
    border-radius: 3px;
    border-width: keys.has-focus ? 2px : 0px;
    border-color: AppTheme.border-focus;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.keyboard-pressed = true;
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if event.text == " " || event.text == Key.Return {
                if root.keyboard-pressed {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
                root.keyboard-pressed = false;
                return accept;
            }
            return reject;
        }
        focus-lost(reason) => { root.keyboard-pressed = false; }
    }
    pointer := TouchArea {
        clicked => {
            keys.focus();
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    content := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 5px;
        Rectangle {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            background: root.checked ? AppTheme.bg-row-selected : AppTheme.bg-input;
            border-width: 1px;
            border-color: root.checked ? AppTheme.text-primary : AppTheme.border-control;
            border-radius: 2px;
            if root.checked: Text {
                text: "✓";
                color: AppTheme.text-primary;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.text;
            color: root.checked ? AppTheme.text-primary : AppTheme.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    if root.description != "": Tooltip { text: @markdown("\{root.description}"); }
}

export component NetworkInspectorView inherits Rectangle {
    min-width: 0px;
    min-height: 0px;
    in property <[TrafficItem]> items: [];
    in property <int> total-count: 0;
    in property <int> visible-count: 0;
    in-out property <int> selected-index: -1;
    in property <string> active-req-headers;
    in property <string> active-req-body;
    in property <string> active-resp-headers;
    in property <string> active-resp-body;
    in property <string> active-timing-text;
    in property <bool> proxy-running;
    in property <string> proxy-addr;
    in-out property <bool> request-body-tab;
    in-out property <bool> response-body-tab;
    in-out property <bool> show-response;
    in-out property <bool> show-details;
    in-out property <float> table-ratio: 0.4;

    // Filter bar state
    in-out property <string> filter-search: "";
    in-out property <int> filter-method-idx: 0;
    in-out property <int> filter-status-idx: 0;
    in-out property <int> filter-outcome-idx: 0;
    in-out property <bool> filter-only-in-scope: false;
    in-out property <bool> filter-hide-connect: false;
    in-out property <bool> filter-hide-failed: false;
    in-out property <bool> filters-expanded: root.height > 300px;

    private property <[string]> method-options: ["All", "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS", "CONNECT", "Other"];
    private property <[string]> status-options: ["All", "1xx", "2xx", "3xx", "4xx", "5xx", "No Response"];
    private property <[string]> outcome-options: ["All", "Pending", "Completed", "Failed"];
    private property <bool> has-active-filters: root.filter-search != "" || root.filter-method-idx != 0 || root.filter-status-idx != 0 || root.filter-outcome-idx != 0 || root.filter-only-in-scope || root.filter-hide-connect || root.filter-hide-failed;

    // Callbacks to Rust
    callback select-item(int);
    callback select-transaction-by-id(string);
    callback clear-history();
    callback filter-search-changed(string);
    callback filter-method-changed(int);
    callback filter-status-changed(int);
    callback filter-outcome-changed(int);
    callback filter-only-in-scope-changed(bool);
    callback filter-hide-connect-changed(bool);
    callback filter-hide-failed-changed(bool);
    callback reset-filters();

    private property <bool> compact: root.width < 800px;
    private property <bool> short: workspace.height < 340px;
    private property <length> table-width: max(1030px, table-scroll.visible-width);

    public function choose(index: int) {
        if index >= 0 && index < root.items.length {
            root.selected-index = index;
            root.select-item(index);
            root.select-transaction-by-id(root.items[index].id);
            let row-top = index * 32px;
            if row-top + rows.content-y < 0px { rows.content-y = -row-top; }
            else if row-top + 32px + rows.content-y > rows.visible-height {
                rows.content-y = rows.visible-height - row-top - 32px;
            }
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Text { text: "HTTP traffic"; color: AppTheme.text-primary; font-size: 14px; font-weight: 600; vertical-alignment: center; }
            if !root.compact: Text {
                text: "Showing " + root.visible-count + " of " + root.total-count + " requests";
                color: AppTheme.text-muted;
                font-size: 12px;
                vertical-alignment: center;
            }
            if root.compact: Text {
                text: root.visible-count + "/" + root.total-count;
                color: AppTheme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            ActionButton {
                text: root.filters-expanded ? "Hide filters" : (root.has-active-filters ? "Filters *" : "Filters");
                selected: root.filters-expanded;
                description: root.filters-expanded ? "Collapse filter controls" : "Expand filter controls";
                clicked => { root.filters-expanded = !root.filters-expanded; }
            }
            ActionButton {
                text: "Reset";
                enabled: true;
                description: "Reset all filter criteria to default neutral state";
                clicked => { root.reset-filters(); }
            }
            ActionButton {
                text: "Clear";
                icon: @image-url("../assets/icons/trash-2.svg");
                enabled: root.total-count > 0;
                description: "Clear captured traffic history";
                clicked => { root.clear-history(); }
            }
        }
        // Filter Bar Panel
        if root.filters-expanded: Rectangle {
            background: AppTheme.bg-card;
            border-color: AppTheme.border-subtle;
            border-width: 1px;
            border-radius: 4px;
            height: 78px;
            VerticalLayout {
                padding: 6px;
                spacing: 6px;
                // Line 1: Search input + Scope & Exclusion Toggles
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    height: 28px;
                    // Search box
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 120px;
                        height: 28px;
                        background: AppTheme.bg-input;
                        border-color: search-input.has-focus ? AppTheme.border-focus : AppTheme.border-subtle;
                        border-width: search-input.has-focus ? 2px : 1px;
                        border-radius: 4px;
                        search-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            y: (parent.height - self.height) / 2;
                            text <=> root.filter-search;
                            single-line: true;
                            font-size: 12px;
                            color: AppTheme.text-primary;
                            accessible-label: "Search host or path";
                            edited => { root.filter-search-changed(self.text); }
                        }
                        if root.filter-search == "": Text {
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                            text: "Search host/path...";
                            font-size: 12px;
                            color: AppTheme.text-disabled;
                        }
                    }
                    // Toggles
                    FilterToggleCheckbox {
                        text: "In scope";
                        checked <=> root.filter-only-in-scope;
                        description: "Filter to show only in-scope target hosts";
                        toggled(val) => { root.filter-only-in-scope-changed(val); }
                    }
                    FilterToggleCheckbox {
                        text: "Hide CONNECT";
                        checked <=> root.filter-hide-connect;
                        description: "Hide tunnel CONNECT requests";
                        toggled(val) => { root.filter-hide-connect-changed(val); }
                    }
                    FilterToggleCheckbox {
                        text: "Hide failed";
                        checked <=> root.filter-hide-failed;
                        description: "Hide failed transactions (completed 4xx/5xx remain visible)";
                        toggled(val) => { root.filter-hide-failed-changed(val); }
                    }
                }
                // Line 2: ComboBox Selectors (Method, Status, Outcome)
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    height: 32px;
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Method:"; font-size: 11px; color: AppTheme.text-muted; vertical-alignment: center; }
                        ComboBox {
                            width: 95px;
                            model: root.method-options;
                            current-index <=> root.filter-method-idx;
                            selected(val) => { root.filter-method-changed(self.current-index); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Status:"; font-size: 11px; color: AppTheme.text-muted; vertical-alignment: center; }
                        ComboBox {
                            width: 105px;
                            model: root.status-options;
                            current-index <=> root.filter-status-idx;
                            selected(val) => { root.filter-status-changed(self.current-index); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: "Outcome:"; font-size: 11px; color: AppTheme.text-muted; vertical-alignment: center; }
                        ComboBox {
                            width: 105px;
                            model: root.outcome-options;
                            current-index <=> root.filter-outcome-idx;
                            selected(val) => { root.filter-outcome-changed(self.current-index); }
                        }
                    }
                }
            }
        }
        workspace := Rectangle {
            background: transparent;
            if root.short: HorizontalLayout {
                y: 0px;
                height: 32px;
                spacing: 6px;
                ActionButton { text: "Traffic"; selected: !root.show-details; clicked => { root.show-details = false; } }
                ActionButton { text: "Details"; selected: root.show-details; clicked => { root.show-details = true; } }
                Rectangle { horizontal-stretch: 1; }
            }
            table := Rectangle {
                y: root.short ? 40px : 0px;
                height: root.short ? workspace.height - 40px : max(100px, min(workspace.height - 180px, workspace.height * root.table-ratio));
                visible: !root.short || !root.show-details;
                background: AppTheme.bg-card;
                border-color: table-keys.has-focus ? AppTheme.border-focus : AppTheme.border-subtle;
                border-width: table-keys.has-focus ? 2px : 1px;
                border-radius: 4px;
                forward-focus: table-keys;
                accessible-role: list;
                accessible-label: "HTTP traffic. Use arrow keys to select a transaction.";
                accessible-item-count: root.items.length;
                table-keys := FocusScope {
                    key-pressed(event) => {
                        if root.items.length == 0 { return reject; }
                        if event.text == Key.DownArrow { root.choose(min(root.items.length - 1, root.selected-index + 1)); return accept; }
                        if event.text == Key.UpArrow { root.choose(max(0, root.selected-index - 1)); return accept; }
                        if event.text == Key.Home { root.choose(0); return accept; }
                        if event.text == Key.End { root.choose(root.items.length - 1); return accept; }
                        if event.text == Key.PageDown { root.choose(min(root.items.length - 1, root.selected-index + max(1, floor(rows.visible-height / 32px)))); return accept; }
                        if event.text == Key.PageUp { root.choose(max(0, root.selected-index - max(1, floor(rows.visible-height / 32px)))); return accept; }
                        return reject;
                    }
                }
                table-scroll := ScrollView {
                    x: 2px; y: 2px;
                    width: parent.width - 4px; height: parent.height - 4px;
                    content-width: root.table-width;
                    content-height: self.visible-height;
                    vertical-scrollbar-policy: always-off;
                    Rectangle {
                        width: root.table-width;
                        height: table-scroll.visible-height;
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle { height: 32px; background: AppTheme.bg-input; TrafficColumns { heading: true; } }
                            rows := ListView {
                                content-width: root.table-width;
                                horizontal-scrollbar-policy: always-off;
                                for item[index] in root.items: Rectangle {
                                    height: 32px;
                                    background: root.selected-index == index ? AppTheme.bg-row-selected : pointer.has-hover ? AppTheme.bg-row-hover : AppTheme.bg-card;
                                    accessible-role: list-item;
                                    accessible-label: item.method + " " + item.host + item.path + ", status " + item.status-code;
                                    accessible-item-selected: root.selected-index == index;
                                    accessible-item-selectable: true;
                                    accessible-item-index: index;
                                    accessible-action-default => { root.choose(index); }
                                    pointer := TouchArea { clicked => { table-keys.focus(); root.choose(index); } }
                                    if root.selected-index == index: Rectangle { x: 0px; y: 0px; width: 2px; background: AppTheme.text-primary; }
                                    TrafficColumns { item: item; }
                                }
                            }
                        }
                    }
                }
                if root.items.length == 0: Rectangle {
                    x: 8px; y: 34px;
                    width: parent.width - 16px; height: max(0px, parent.height - 42px);
                    background: AppTheme.bg-card;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "No HTTP traffic captured"; font-size: 14px; color: AppTheme.text-primary; horizontal-alignment: center; }
                        Text { text: root.proxy-running ? "Use proxy " + root.proxy-addr + " or test local capture." : "Capture is stopped. Start capture to inspect traffic."; font-size: 12px; color: AppTheme.text-muted; wrap: word-wrap; horizontal-alignment: center; }
                    }
                }
            }
            if !root.short: Rectangle {
                y: table.height;
                height: 10px;
                forward-focus: split-keys;
                accessible-role: slider;
                accessible-label: "Traffic table height";
                accessible-value: round(root.table-ratio * 100) + "%";
                accessible-value-minimum: 20;
                accessible-value-maximum: 65;
                accessible-action-increment => { root.table-ratio = min(0.65, root.table-ratio + 0.05); }
                accessible-action-decrement => { root.table-ratio = max(0.2, root.table-ratio - 0.05); }
                background: split-touch.has-hover || split-keys.has-focus ? AppTheme.bg-row-selected : transparent;
                Rectangle { x: (parent.width - 36px) / 2; y: 4px; width: 36px; height: 2px; background: AppTheme.text-muted; }
                split-keys := FocusScope {
                    key-pressed(event) => {
                        if event.text == Key.DownArrow { root.table-ratio = min(0.65, root.table-ratio + 0.05); return accept; }
                        if event.text == Key.UpArrow { root.table-ratio = max(0.2, root.table-ratio - 0.05); return accept; }
                        return reject;
                    }
                }
                split-touch := TouchArea {
                    mouse-cursor: ns-resize;
                    moved => { if self.pressed { root.table-ratio = max(0.2, min(0.65, (table.height + self.mouse-y) / workspace.height)); } }
                }
            }
            details := Rectangle {
                y: root.short ? 40px : table.height + 10px;
                height: max(0px, workspace.height - self.y);
                visible: !root.short || root.show-details;
                background: transparent;
                if root.short: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        ActionButton { text: "Request"; selected: !root.show-response; clicked => { root.show-response = false; } }
                        ActionButton { text: "Response"; description: root.active-timing-text; selected: root.show-response; clicked => { root.show-response = true; } }
                        ActionButton { text: "Headers"; selected: root.show-response ? !root.response-body-tab : !root.request-body-tab; clicked => { if root.show-response { root.response-body-tab = false; } else { root.request-body-tab = false; } } }
                        ActionButton { text: "Body"; selected: root.show-response ? root.response-body-tab : root.request-body-tab; clicked => { if root.show-response { root.response-body-tab = true; } else { root.request-body-tab = true; } } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    DocumentView {
                        label: root.show-response ? "Response detail" : "Request detail";
                        text: root.selected-index < 0 || root.selected-index >= root.items.length ? "" : root.show-response ? (root.response-body-tab ? root.active-resp-body : root.active-resp-headers) : (root.request-body-tab ? root.active-req-body : root.active-req-headers);
                        empty-text: root.selected-index < 0 || root.selected-index >= root.items.length ? "Select a transaction to inspect it" : "No content in this section";
                    }
                }
                if !root.short: VerticalLayout {
                    spacing: 8px;
                    if root.compact: HorizontalLayout {
                        height: 32px;
                        spacing: 6px;
                        ActionButton { text: "Request"; selected: !root.show-response; clicked => { root.show-response = false; } }
                        ActionButton { text: "Response"; selected: root.show-response; clicked => { root.show-response = true; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if !root.compact || !root.show-response: DocumentPanel {
                            horizontal-stretch: 1;
                            title: "Request";
                            headers: root.active-req-headers;
                            body: root.active-req-body;
                            has-selection: root.selected-index >= 0 && root.selected-index < root.items.length;
                            body-tab <=> root.request-body-tab;
                        }
                        if !root.compact || root.show-response: DocumentPanel {
                            horizontal-stretch: 1;
                            title: "Response";
                            summary: root.active-timing-text;
                            headers: root.active-resp-headers;
                            body: root.active-resp-body;
                            has-selection: root.selected-index >= 0 && root.selected-index < root.items.length;
                            body-tab <=> root.response-body-tab;
                        }
                    }
                }
            }
        }
        if root.height > 300px: Text { text: "Text preview | Response inspection is limited to 2 MiB; binary data may appear as replacement characters."; font-size: 12px; color: AppTheme.text-muted; wrap: word-wrap; }
    }
}
