import { PageScrollView } from "../components/page_scroll_view.slint";
import { AppTheme } from "../styles/theme.slint";
import { ActionButton } from "../components/action_button.slint";
import { DocumentView } from "../components/document_view.slint";

export component RepeaterView inherits Rectangle {
    min-width: 0px;
    min-height: 0px;
    private property <bool> show-response;
    private property <bool> compact: root.width < 800px;
    PageScrollView {
        label: "Read-only HTTP Repeater";
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        Text { text: "Read-only preview | Interactive replay is not connected yet"; color: AppTheme.text-primary; font-size: 13px; wrap: word-wrap; }
        if root.compact: HorizontalLayout {
            spacing: 6px;
            ActionButton { text: "Request"; selected: !root.show-response; clicked => { root.show-response = false; } }
            ActionButton { text: "Response"; selected: root.show-response; clicked => { root.show-response = true; } }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 8px;
            if !root.compact || !root.show-response: Rectangle {
                horizontal-stretch: 1;
                background: AppTheme.bg-card;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 4px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: "Request example | Read only"; color: AppTheme.text-primary; font-size: 14px; font-weight: 600; }
                    Text { text: "GET http://127.0.0.1:8989/api/status"; color: AppTheme.text-secondary; font-size: 13px; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        ActionButton { text: "Send"; icon: @image-url("../assets/icons/play.svg"); enabled: false; description: "This view is not connected to the native replay engine"; }
                        Text { text: "Not available"; color: AppTheme.text-muted; font-size: 12px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    DocumentView {
                        min-height: 160px;
                        preferred-height: 260px;
                        label: "Read-only request example";
                        text: "GET /api/status HTTP/1.1\nHost: 127.0.0.1:8989\nUser-Agent: Kaska-Repeater/0.1\nAccept: application/json\nConnection: close\n";
                    }
                }
            }
            if !root.compact || root.show-response: Rectangle {
                horizontal-stretch: 1;
                background: AppTheme.bg-card;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 4px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text { text: "Response"; color: AppTheme.text-primary; font-size: 14px; font-weight: 600; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text { text: "No replay response"; color: AppTheme.text-primary; font-size: 16px; horizontal-alignment: center; }
                        Text { text: "Sending from this view is not available yet."; color: AppTheme.text-muted; font-size: 13px; wrap: word-wrap; horizontal-alignment: center; }
                    }
                }
            }
        }
    }
    }
}
