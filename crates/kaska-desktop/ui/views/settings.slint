import { AppTheme } from "../styles/theme.slint";

export component SettingsView inherits Rectangle {
    in property <string> proxy-port: "8080";
    in property <string> test-port: "8989";
    in property <string> os-info: "Windows x86_64";
    in property <string> slint-version: "1.18.1";

    background: transparent;

    Flickable {
        content-height: 640px;

        VerticalLayout {
            padding: 20px;
            spacing: 16px;

            // Section 1: Network Engine Configuration
            Rectangle {
                background: AppTheme.bg-card;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    Text {
                        text: "Native Proxy Engine Settings";
                        color: AppTheme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Local HTTP Proxy Listener Port:";
                            color: AppTheme.text-secondary;
                            font-size: 12px;
                        }
                        Text {
                            text: "127.0.0.1:" + root.proxy-port;
                            color: AppTheme.accent;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Local Controlled Test Server Port:";
                            color: AppTheme.text-secondary;
                            font-size: 12px;
                        }
                        Text {
                            text: "127.0.0.1:" + root.test-port;
                            color: AppTheme.success;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Proxy Architecture:";
                            color: AppTheme.text-secondary;
                            font-size: 12px;
                        }
                        Text {
                            text: "Pure Native Rust TCP / HTTP Engine";
                            color: AppTheme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                }
            }

            // Section 2: Host Diagnostics
            Rectangle {
                background: AppTheme.bg-card;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;

                    Text {
                        text: "Host System & Runtime";
                        color: AppTheme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Operating System & Architecture:";
                            color: AppTheme.text-secondary;
                            font-size: 12px;
                        }
                        Text {
                            text: root.os-info;
                            color: AppTheme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Graphical Toolkit Engine:";
                            color: AppTheme.text-secondary;
                            font-size: 12px;
                        }
                        Text {
                            text: "Slint v" + root.slint-version + " (Native Desktop Renderer)";
                            color: AppTheme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                }
            }

            // Section 3: About / Licenses / Credits
            Rectangle {
                background: AppTheme.bg-card;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 8px;

                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    Text {
                        text: "About, Licenses & Open Source Credits";
                        color: AppTheme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                    }

                    Text {
                        text: "Kaska is an open-source, free security engineering and education platform built with Rust.\n\n• Purpose: Cybersecurity education, technical research, CTFs, self-hosted labs, and authorized assessments.\n• Native Design: Pure Rust implementations of networking and security capabilities. Zero wrappers around external binaries.\n• Graphical Interface: Built with the Slint GUI toolkit (https://slint.dev) under the Royalty-Free Desktop / GPLv3 licensing terms.\n• Attribution: Special recognition to SixtyFPS GmbH and the Slint community for high-performance desktop rendering.";
                        color: AppTheme.text-secondary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Rectangle {
                        height: 1px;
                        background: AppTheme.border-subtle;
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Repository & Community:";
                            color: AppTheme.text-muted;
                            font-size: 11px;
                        }
                        Text {
                            text: "GitHub Open Source Ready • Free for Community & Education";
                            color: AppTheme.accent;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }
                }
            }
        }
    }
}
