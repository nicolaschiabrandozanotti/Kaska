import { PageScrollView } from "../components/page_scroll_view.slint";
import { AboutSlint } from "std-widgets.slint";
import { AppTheme } from "../styles/theme.slint";
import { KeyValueRow } from "../components/key_value_row.slint";

export component SettingsView inherits Rectangle {
    min-width: 0px;
    min-height: 0px;
    in property <string> proxy-port: "8080";
    in property <string> test-port: "8989";
    in property <string> os-info: "Windows x86_64";
    in property <string> slint-version: "1.18.1";
    PageScrollView {
        label: "Settings and About";
        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            alignment: start;
            Rectangle {
                background: AppTheme.bg-card;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 4px;
                VerticalLayout {
                    padding: 16px; spacing: 8px;
                    Text { text: "Network configuration | Read only"; font-size: 16px; font-weight: 600; color: AppTheme.text-primary; }
                    KeyValueRow { label: "Local HTTP proxy listener"; value: "127.0.0.1:" + root.proxy-port; }
                    KeyValueRow { label: "Controlled local test server"; value: "127.0.0.1:" + root.test-port; }
                    KeyValueRow { label: "Proxy architecture"; value: "Native Rust TCP / HTTP"; }
                }
            }
            Rectangle {
                background: AppTheme.bg-card;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 4px;
                VerticalLayout {
                    padding: 16px; spacing: 8px;
                    Text { text: "Host system & runtime"; font-size: 16px; font-weight: 600; color: AppTheme.text-primary; }
                    KeyValueRow { label: "Operating system & architecture"; value: root.os-info; }
                    KeyValueRow { label: "Graphical toolkit"; value: "Slint " + root.slint-version; }
                }
            }
            Rectangle {
                background: AppTheme.bg-card;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 4px;
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    Text { text: "About, licenses & open source credits"; font-size: 16px; font-weight: 600; color: AppTheme.text-primary; wrap: word-wrap; }
                    Text { text: "Kaska is an open-source, free security engineering and education platform built with Rust.\n\n• Purpose: Cybersecurity education, technical research, CTFs, self-hosted labs, and authorized assessments.\n• Native Design: Pure Rust implementations of networking and security capabilities. Zero wrappers around external binaries.\n• Kaska License: Original source code is dual-licensed under MIT OR Apache-2.0.\n• Slint License: Graphical interface built with the Slint GUI toolkit (https://slint.dev) under the Slint Royalty-Free Desktop, Mobile, and Web Applications License 2.0.\n• Slint Copyright: Copyright © SixtyFPS GmbH."; color: AppTheme.text-secondary; font-size: 13px; wrap: word-wrap; }
                    AboutSlint { }
                    Text { text: "Repository & community | MIT OR Apache-2.0"; color: AppTheme.text-muted; font-size: 12px; wrap: word-wrap; }
                }
            }
        }
    }
}
