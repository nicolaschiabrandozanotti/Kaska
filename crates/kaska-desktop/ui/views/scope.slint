import { PageScrollView } from "../components/page_scroll_view.slint";
import { AppTheme } from "../styles/theme.slint";
import { KeyValueRow } from "../components/key_value_row.slint";

export component ScopeView inherits Rectangle {
    min-width: 0px;
    min-height: 0px;
    PageScrollView {
        label: "Target scope";
        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            alignment: start;
            Text { text: "Localhost lab | Fixed scope in this version"; color: AppTheme.text-primary; font-size: 14px; wrap: word-wrap; }
            Rectangle {
                background: AppTheme.bg-card;
                border-color: AppTheme.border-subtle;
                border-width: 1px;
                border-radius: 4px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text { text: "Configured targets"; color: AppTheme.text-primary; font-size: 16px; font-weight: 600; }
                    KeyValueRow { label: "127.0.0.1 (IPv4)"; value: "Allowed host"; }
                    KeyValueRow { label: "localhost"; value: "Allowed host"; }
                    KeyValueRow { label: "::1 (IPv6)"; value: "Allowed host"; }
                    Rectangle { height: 1px; background: AppTheme.border-subtle; }
                    Text { text: "Resolved destinations must be loopback addresses. The proxy rejects out-of-scope traffic."; color: AppTheme.text-secondary; font-size: 13px; wrap: word-wrap; }
                    Text { text: "HTTP CONNECT is not supported. This view does not edit the scope."; color: AppTheme.text-muted; font-size: 13px; wrap: word-wrap; }
                }
            }
        }
    }
}
